<?xml version="1.0" encoding="utf-8"?>
<!-- Release: publicly trusted certificates only and no cleartext (AD-13). Never a bypass. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
