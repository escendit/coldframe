{
  "realm": "coldframe",
  "displayName": "Coldframe",
  "enabled": true,
  "registrationAllowed": true,
  "organizationsEnabled": true,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "coldframe-web",
      "name": "Coldframe web",
      "description": "The SvelteKit web app. Confidential; Authorization Code with PKCE only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${COLDFRAME_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:5173/.oidc/signin/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/.oidc/signout/callback"
      }
    }
  ]
}
