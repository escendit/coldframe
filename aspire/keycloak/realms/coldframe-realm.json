{
  "id": "coldframe",
  "realm": "coldframe",
  "displayName": "Coldframe",
  "enabled": true,
  "registrationAllowed": true,
  "organizationsEnabled": true,
  "sslRequired": "external",
  "eventsListeners": ["jboss-logging", "temporal"],
  "attributes": {
    "_providerConfig.orgs.config.createAdminUser": "false"
  },
  "clients": [
    {
      "clientId": "coldframe-web",
      "name": "Coldframe web",
      "description": "The SvelteKit web app. Confidential; Authorization Code with PKCE only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${COLDFRAME_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:5173/.oidc/signin/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/.oidc/signout/callback"
      },
      "protocolMappers": [
        {
          "name": "coldframe-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "coldframe-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "coldframe-mobile",
      "name": "Coldframe mobile",
      "description": "The iOS and Android apps. Public; Authorization Code with PKCE (S256) only, no secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["com.escendit.coldframe:/signin/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.escendit.coldframe:/signout/callback"
      },
      "protocolMappers": [
        {
          "name": "coldframe-server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "coldframe-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "coldframe-server",
      "name": "Coldframe Server",
      "description": "The Server's own service account. Confidential; client credentials only. Manages Phase Two Organizations, nothing else.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${COLDFRAME_SERVER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-coldframe-server",
      "enabled": true,
      "serviceAccountClientId": "coldframe-server",
      "clientRoles": {
        "realm-management": ["view-organizations", "manage-organizations"]
      }
    }
  ]
}
