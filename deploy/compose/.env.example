# The settings of the Compose reference example (deploy/compose/README.md): REFERENCE EXAMPLE ONLY,
# not the supported deployment. Copy this file to .env (git ignores it) and replace every value.
# The values here are placeholders that only make `docker compose config` pass.
#
# Compose interpolates `$` in .env values: use the suggested openssl commands, and single-quote any
# value that contains `$`. Never commit a filled .env.

# The release to run, without the leading v (a tag vX.Y.Z publishes the images as X.Y.Z). There
# is no default and no `latest`.
COLDFRAME_VERSION=X.Y.Z

# The LAN name or IP address of the Docker host. The browser and the containers both use it, so
# the Keycloak issuer is the same string for both (web http://<host>:3000, Keycloak <host>:8180).
COLDFRAME_HOST=192.168.1.10

# PostgreSQL: the superuser, and the passwords of the roles coldframe, temporal and keycloak.
# The coldframe password must not contain ';' (it goes into a connection string).
POSTGRES_PASSWORD=replace-me-postgres
COLDFRAME_DB_PASSWORD=replace-me-coldframe-db
TEMPORAL_DB_PASSWORD=replace-me-temporal-db
KEYCLOAK_DB_PASSWORD=replace-me-keycloak-db

# The temporary admin of Keycloak's master realm, created on the first start.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me-keycloak-admin

# The secrets of the coldframe-web and coldframe-server clients, substituted into the realm at
# the first import (openssl rand -hex 32).
WEB_CLIENT_SECRET=replace-me-web-client-secret
SERVER_CLIENT_SECRET=replace-me-server-client-secret

# The SMTP server for registration and invitation emails. SMTP_USERNAME and SMTP_PASSWORD may stay
# empty with SMTP_AUTH=false.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=coldframe@example.org
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Device enrolment: the X25519 private key as PKCS#8 PEM, on one line with \n between the lines
# and in double quotes (deploy/compose/README.md shows the command), and the key-encryption key
# of the stored Device keys, at least 32 characters (openssl rand -base64 32). Record the KEK
# outside this machine: without it no enrolled Device works.
ENROLMENT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
DEVICE_KEK=replace-me-with-at-least-32-characters
