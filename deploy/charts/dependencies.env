# Pinned cluster dependencies of the Coldframe charts (Story 2.3). One source for test.sh (CRD
# schemas), smoke.sh (installs) and the Fleet bundles (Story 2.5). Sourced by bash; plain
# NAME=value lines only. Every manifest download is checked against its sha256.
#
# Bumping a pin: change the version and URL, download the file, and replace the sha256 with the
# output of `sha256sum <file>`.

# cert-manager: the Barman Cloud plugin needs it for the TLS of its gRPC endpoint.
CERT_MANAGER_VERSION=v1.21.2
CERT_MANAGER_URL=https://github.com/cert-manager/cert-manager/releases/download/v1.21.2/cert-manager.yaml
CERT_MANAGER_SHA256=e03b668ec8675214af6b0a671699d088f2601fa3878e0dbe1b41d3feafd1879f

# CloudNativePG operator and CRDs (namespace cnpg-system).
CNPG_VERSION=1.30.1
CNPG_URL=https://github.com/cloudnative-pg/cloudnative-pg/releases/download/v1.30.1/cnpg-1.30.1.yaml
CNPG_SHA256=37237f145d8138256ea25ae830f87759255665ff08f8d552fdd8224a5ec032fb

# Barman Cloud CNPG-I plugin (namespace cnpg-system, after CNPG and cert-manager).
BARMAN_CLOUD_PLUGIN_VERSION=v0.15.0
BARMAN_CLOUD_PLUGIN_URL=https://github.com/cloudnative-pg/plugin-barman-cloud/releases/download/v0.15.0/manifest.yaml
BARMAN_CLOUD_PLUGIN_SHA256=1c483eae12a7424ad28ac66bdfee771b510ee8e234cb8756c3ade7254cef2fad

# Test only (smoke.sh): RustFS stands in for the S3 backup target, aws-cli creates its bucket.
RUSTFS_IMAGE=docker.io/rustfs/rustfs:1.0.0
AWS_CLI_IMAGE=docker.io/amazon/aws-cli:2.37.4
