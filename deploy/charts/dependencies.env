# Pinned cluster dependencies of the Coldframe charts (Stories 2.3 to 2.5a). One source for test.sh
# (CRD schemas, the Traefik render, the Fleet bundle checks), smoke.sh (installs), the Fleet bundles
# and the Fleet smoke (deploy/fleet/smoke.sh). Sourced by bash; plain NAME=value lines only.
# Every manifest, chart and binary this repository's scripts download is checked against its
# sha256. The operator charts of the Fleet bundles are not: Fleet (and `fleet apply` in test.sh)
# fetches them from their Helm repos by the pinned repo and chart version only.
#
# Bumping a pin: change the version and URL, download the file, and replace the sha256 with the
# output of `sha256sum <file>`. The operator bundles (deploy/fleet/<operator>/fleet.yaml) name their
# Helm repo and chart version too: deploy/fleet/check-fleet.py fails when they differ from the
# *_HELM_REPO and *_CHART_VERSION lines below, so bump both together.

# cert-manager: the Barman Cloud plugin needs it for the TLS of its gRPC endpoint, and the ingress
# chart's Issuer and Certificate (Story 2.4).
CERT_MANAGER_VERSION=v1.21.2
CERT_MANAGER_URL=https://github.com/cert-manager/cert-manager/releases/download/v1.21.2/cert-manager.yaml
CERT_MANAGER_SHA256=e03b668ec8675214af6b0a671699d088f2601fa3878e0dbe1b41d3feafd1879f
# The same cert-manager as a Helm chart: the Fleet bundle deploy/fleet/cert-manager.
CERT_MANAGER_HELM_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.21.2

# CloudNativePG operator and CRDs (namespace cnpg-system).
CNPG_VERSION=1.30.1
CNPG_URL=https://github.com/cloudnative-pg/cloudnative-pg/releases/download/v1.30.1/cnpg-1.30.1.yaml
CNPG_SHA256=37237f145d8138256ea25ae830f87759255665ff08f8d552fdd8224a5ec032fb
# The chart that ships CloudNativePG 1.30.1: the Fleet bundle deploy/fleet/cloudnative-pg.
CNPG_HELM_REPO=https://cloudnative-pg.github.io/charts
CNPG_CHART_VERSION=0.29.1

# Barman Cloud CNPG-I plugin (namespace cnpg-system, after CNPG and cert-manager).
BARMAN_CLOUD_PLUGIN_VERSION=v0.15.0
BARMAN_CLOUD_PLUGIN_URL=https://github.com/cloudnative-pg/plugin-barman-cloud/releases/download/v0.15.0/manifest.yaml
BARMAN_CLOUD_PLUGIN_SHA256=1c483eae12a7424ad28ac66bdfee771b510ee8e234cb8756c3ade7254cef2fad
# The chart that ships the plugin v0.15.0: the Fleet bundle deploy/fleet/barman-cloud.
BARMAN_CLOUD_PLUGIN_HELM_REPO=https://cloudnative-pg.github.io/charts
BARMAN_CLOUD_PLUGIN_CHART_VERSION=0.8.0

# Fleet (Story 2.5a): the fleet CLI (test.sh renders the bundles with it; CI installs it) and the
# fleet-crd and fleet charts (docs/operations/install.md and the Fleet smoke, deploy/fleet/smoke.sh,
# install them from these sha-checked URLs).
FLEET_VERSION=v0.16.2
FLEET_CLI_URL_AMD64=https://github.com/rancher/fleet/releases/download/v0.16.2/fleet-linux-amd64
FLEET_CLI_SHA256_AMD64=3e15a4adfaad2e795993bc938d4122071da40d03190c90e8a6426948f9a19a9a
FLEET_CLI_URL_ARM64=https://github.com/rancher/fleet/releases/download/v0.16.2/fleet-linux-arm64
FLEET_CLI_SHA256_ARM64=a43b471f734397b653275c59a020aefe51fe3e1cc6cb70e6ce323ccad4fe6e9d
FLEET_HELM_REPO=https://rancher.github.io/fleet-helm-charts/
FLEET_CRD_CHART_URL=https://github.com/rancher/fleet/releases/download/v0.16.2/fleet-crd-0.16.2.tgz
FLEET_CRD_CHART_SHA256=aeccddf3e5502f528da046010c2ac9d62239f1e3a0e2462791fe9fddd57c5fc2
FLEET_CHART_URL=https://github.com/rancher/fleet/releases/download/v0.16.2/fleet-0.16.2.tgz
FLEET_CHART_SHA256=51b6027b148a0152e87b953568309698bb307eab13c486bff2c8f0d3b3aecbcd

# RKE2's bundled Traefik, as RKE2 v1.36.4+rke2r1 ships it (Story 2.4). Not installed on RKE2 (RKE2
# runs it); test.sh renders it with deploy/rke2/rke2-traefik-config.yaml, smoke.sh installs it.
RKE2_TRAEFIK_VERSION=40.1.010
RKE2_TRAEFIK_URL=https://rke2-charts.rancher.io/assets/rke2-traefik-1.34-1.36/rke2-traefik-40.1.010.tgz
RKE2_TRAEFIK_SHA256=f15c97da5d655baf7e1e658eb118eaee9598f2a9bdb3d038436aadcb4825f21e
RKE2_TRAEFIK_CRD_URL=https://rke2-charts.rancher.io/assets/rke2-traefik-1.34-1.36/rke2-traefik-crd-40.1.010.tgz
RKE2_TRAEFIK_CRD_SHA256=77b34bbda2930bcfd314dc8d5463f038f7ce4e00b9b11c9c57802e5676f7b05b

# Test only (smoke.sh): RustFS stands in for the S3 backup target, aws-cli creates its bucket.
RUSTFS_IMAGE=docker.io/rustfs/rustfs:1.0.0
AWS_CLI_IMAGE=docker.io/amazon/aws-cli:2.37.4
