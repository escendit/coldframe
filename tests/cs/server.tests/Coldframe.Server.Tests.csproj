<Project Sdk="Microsoft.NET.Sdk">
  <!-- Server tests that need no containers: event registry, fixture journal replay, time, bans. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Coldframe.Server.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\apps\cs\migrations\Coldframe.Migrations.csproj" />
    <ProjectReference Include="..\..\..\apps\cs\server\Coldframe.Server.csproj" />
    <ProjectReference Include="..\..\..\packages\cs\contracts\Coldframe.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
