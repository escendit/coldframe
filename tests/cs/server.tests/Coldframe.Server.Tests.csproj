<Project Sdk="Microsoft.NET.Sdk">
  <!-- Server tests that need no containers: event registry, fixture journal replay, time, bans, Edge API rules. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Coldframe.Server.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\apps\cs\migrations\Coldframe.Migrations.csproj" />
    <ProjectReference Include="..\..\..\apps\cs\server\Coldframe.Server.csproj" />
    <ProjectReference Include="..\..\..\packages\cs\contracts\Coldframe.Contracts.csproj" />
    <!-- Device-path tests build their requests with the simulator only (AD-24). -->
    <ProjectReference Include="..\device-simulator\Coldframe.DeviceSimulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Edge API contract; the endpoint discovery test compares the mapped endpoints with it. -->
    <None Include="..\..\..\packages\openapi\coldframe.openapi.json" Link="Fixtures\coldframe.openapi.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The push payload contract's examples; the channel tests require that what they send equals them. -->
    <None Include="..\..\..\packages\asyncapi\fixtures\*.json" Link="Fixtures\asyncapi\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared crypto vectors; the enrolment key tests open the vector enrolment. -->
    <None Include="..\..\..\packages\crypto-spec\vectors.json" Link="Fixtures\vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
