<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Coldframe.Server.IntegrationTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="NATS.Net" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Temporalio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\aspire\Coldframe.AppHost\Coldframe.AppHost.csproj" />
    <ProjectReference Include="..\..\..\apps\cs\migrations\Coldframe.Migrations.csproj" />
    <ProjectReference Include="..\..\..\apps\cs\server\Coldframe.Server.csproj" />
    <ProjectReference Include="..\..\..\packages\cs\contracts\Coldframe.Contracts.csproj" />
    <ProjectReference Include="..\..\..\packages\cs\crypto\Coldframe.Crypto.csproj" />
    <!-- Device-path tests drive the Server through the Device simulator only (AD-24). -->
    <ProjectReference Include="..\device-simulator\Coldframe.DeviceSimulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared crypto vectors: enrolment tests use the vector root key. -->
    <None Include="..\..\..\packages\crypto-spec\vectors.json" Link="Fixtures\vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The test-only sample events and state are shared with the unit tests, so the fixture journal covers them. -->
  <ItemGroup>
    <Compile Include="..\server.tests\Samples\*.cs" Link="Journal\Samples\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The authorization matrix lists the Edge API endpoints exactly as the unit tests do. -->
  <ItemGroup>
    <Compile Include="..\server.tests\Edge\EdgeEndpointCatalog.cs" Link="Edge\EdgeEndpointCatalog.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
